# Copy to .env and fill in, or just export these in your shell.
#
# We call Gemini directly via its OpenAI-compatible endpoint. Grab a free key
# from Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=AIza...

# Gemini's OpenAI-compatible base URL (don't change unless Google moves it).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model id. gemini-3.5-flash is fast + cheap with solid reasoning; swap to
# gemini-3-pro-preview if you want the strongest (slower) reasoner.
GEMINI_MODEL=gemini-3.5-flash
