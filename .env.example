# ---------------------------------------------------------------------------
# Matcha — phone-first voice career agent
# Copy this file to `.env` (project root) or `agent-py/.env.local` and fill in.
# The agent loads both `.env.local` and `.env`.
# ---------------------------------------------------------------------------

# --- LiveKit (REQUIRED for connecting / telephony) -------------------------
# Get these from https://cloud.livekit.io  (or `lk app env -w -d .env.local`)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- MiniMax TTS (preferred voice; falls back to Inference TTS if unset) ----
# https://docs.livekit.io/agents/models/tts/minimax/
MINIMAX_API_KEY=your-minimax-api-key
# Optional, required by some MiniMax accounts/regions:
MINIMAX_GROUP_ID=your-minimax-group-id

# --- Moss (OPTIONAL: retrieval/memory; demo path works without it) ----------
# The starter uses project id + key. MOSS_API_KEY is accepted as an alias.
MOSS_PROJECT_ID=your-moss-project-id
MOSS_PROJECT_KEY=your-moss-project-key
MOSS_API_KEY=your-moss-api-key

# --- Optional tuning --------------------------------------------------------
# Directory where per-call debug snapshots (profile + recs) are written.
MATCHA_DEBUG_DIR=debug
