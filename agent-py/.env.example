LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Moss — semantic search / memory (https://docs.moss.dev/docs)
# MOSS_PROJECT_ID / MOSS_PROJECT_KEY are filled in at index/run time (Task 9).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=knowledge
MOSS_MEMORY_INDEX_NAME=memory
MOSS_MODEL_ID=moss-minilm

# Gemini — powers the LLM job matcher (llm_recommend.py). If GEMINI_API_KEY is
# unset or the call fails, the agent falls back to the keyword matcher and logs
# it loudly. Get a free key at https://aistudio.google.com/apikey
# Each model has its own free-tier DAILY request bucket (gemini-3.5-flash is a
# stingy 20/day). The -flash-lite models have roomier buckets — better for a demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
